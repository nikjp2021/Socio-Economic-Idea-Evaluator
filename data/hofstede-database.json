    "dimensions": {
      "pdi": {
        "name": "Power Distance Index",
        "description": "Acceptance of hierarchical order and authority"
      },
      "idv": {
        "name": "Individualism",
        "description": "Degree of interdependence among members of society"
      },
      "mas": {
        "name": "Masculinity",
        "description": "Preference for achievement, heroism, assertiveness"
      },
      "uai": {
        "name": "Uncertainty Avoidance",
        "description": "Society's tolerance for ambiguity"
      },
      "lto": {
        "name": "Long-Term Orientation",
        "description": "Focus on future rewards over short-term benefits"
      },
      "ivr": {
        "name": "Indulgence vs Restraint",
        "description": "Degree to which people control their desires and impulses"
      }
    }
  },
