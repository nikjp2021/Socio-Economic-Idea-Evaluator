# Socio-Economic Evaluator — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# For Netlify: set these in Site settings → Environment variables
# For Vercel: set these in Settings → Environment Variables

# Gemini API key (required for Netlify function with Google Search Grounding)
# Get one at https://aistudio.google.com/apikey
# If using Netlify AI Gateway, this is auto-injected
GOOGLE_GENAI_API_KEY=

# Optional: Serper API key for web search (Phase 2)
# Get one at https://serper.dev
SERPER_API_KEY=

# Optional: Override default server port (local dev)
PORT=8080
