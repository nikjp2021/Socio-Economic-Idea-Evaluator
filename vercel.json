{
  "builds": [
    { "src": "api/eval.mjs", "use": "@vercel/edge" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/eval", "dest": "api/eval.mjs" },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(data/.*)", "dest": "/$1" },
    { "src": "/(case-studies/.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
