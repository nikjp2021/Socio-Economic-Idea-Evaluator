{
  "builds": [
    {
      "src": "api/eval.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/evaluations.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/eval", "destination": "/api/eval.mjs" },
    { "source": "/api/auth", "destination": "/api/auth.mjs" },
    { "source": "/api/evaluations", "destination": "/api/evaluations.mjs" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
