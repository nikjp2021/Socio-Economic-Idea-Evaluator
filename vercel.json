{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*\\.(json))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "outputDirectory": ".",
  "includeFiles": [
    "evaluator.py",
    "data/**",
    "case-studies/**"
  ]
}
